  {
    "id": "puzzlear-validate",
    "type": "function",
    "z": "puzzlear-tab",
    "name": "Controleer code en maak bericht",
    "x": 400,
    "y": 100,
    "wires": [
      [
        "puzzlear-mqtt"
      ],
      [
        "puzzlear-response"
      ]
    ],
    "func": "msg.headers = {\"Access-Control-Allow-Origin\":\"*\", \"Content-Type\":\"application/json\", \"Cache-Control\":\"no-store\"};\nconst code = msg.payload && msg.payload.code;\nif (code !== \"48\") {\n    msg.statusCode = 400;\n    msg.payload = {ok:false, error:\"Deze code klopt niet.\"};\n    return [null, msg];\n}\nif (flow.get(\"puzzlearMqttConnected\") !== true) {\n    msg.statusCode = 503;\n    msg.payload = {ok:false, error:\"MQTT-broker nog niet verbonden. Probeer opnieuw.\"};\n    return [null, msg];\n}\nconst bericht = {\n    topic: \"PuzzleAR\",\n    payload: JSON.stringify({message:\"pass\", timestamp:new Date().toISOString()}),\n    qos: \"1\",\n    retain: false\n};\nmsg.statusCode = 202;\nmsg.payload = {ok:true, status:\"accepted\"};\nreturn [bericht, msg];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
  },
