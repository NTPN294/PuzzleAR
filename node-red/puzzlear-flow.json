  {
    "id": "puzzlear-relay-validate",
    "type": "function",
    "z": "puzzlear-relay-v2",
    "name": "Controleer bericht en behoud timestamp",
    "func": "// Geen oude retained berichten opnieuw doorsturen.\nif (msg.retain) return null;\nlet data = msg.payload;\ntry { if (typeof data === \"string\") data = JSON.parse(data); }\ncatch { return null; }\nif (!data || data.message !== \"pass\" || typeof data.timestamp !== \"string\" || !Number.isFinite(Date.parse(data.timestamp))) return null;\n// QoS 1 kan hetzelfde bericht opnieuw afleveren.\nconst sleutel = data.message + \":\" + data.timestamp;\nif (context.get(\"laatsteBericht\") === sleutel) return null;\ncontext.set(\"laatsteBericht\", sleutel);\nmsg.topic = \"PuzzleAR\";\nmsg.payload = JSON.stringify({message:\"pass\", timestamp:data.timestamp});\nmsg.qos = 1;\nmsg.retain = false;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 470,
    "y": 100,
    "wires": [
      [
        "puzzlear-local-out",
        "puzzlear-relay-debug"
      ]
    ]
  },
  {
    "id": "puzzlear-local-out",
    "type": "mqtt out",
    "z": "puzzlear-relay-v2",
    "name": "Lokale MQTT: PuzzleAR",
    "topic": "PuzzleAR",
    "qos": "1",
    "retain": "false",
    "broker": "puzzlear-local-v2",
